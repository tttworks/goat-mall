# GOAT 潮玩交易平台 · 站点系统后端环境样例（占位值，真实凭据只存服务器 .env / gobt_secrets.env）
# Copyright © 火山文化科技（天津市火山文化科技有限责任公司） / Author: Aloysius Luo

APP_NAME="GOAT Mall"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://goat.websitedemos.cn
APP_LOCALE=zh_CN

# --- 应用进程（Octane / Swoole）---
OCTANE_SERVER=swoole
OCTANE_HTTPS=false
OCTANE_WORKERS=4
OCTANE_MAX_REQUESTS=500

# --- PostgreSQL 17（经 PgBouncer 连接，事务池模式）---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=6432
DB_DATABASE=goat_mall
DB_USERNAME=goat
DB_PASSWORD=
DB_SCHEMA=public

# --- Redis（独立 DB index：0 缓存 / 1 队列 / 2 广播）---
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1
REDIS_QUEUE=goat:default
REDIS_PREFIX=goat:

# --- 队列（Horizon）---
QUEUE_CONNECTION=redis
HORIZON_PREFIX=goat_horizon:

# --- 广播（Reverb WebSocket）---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=goat.websitedemos.cn
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# --- Meilisearch ---
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
SCOUT_PREFIX=goat_

# --- 对象存储 UCloud UFile（S3 协议）；DB 只存对象 key ---
FILESYSTEM_DISK=ufile
UFILE_ACCESS_KEY=
UFILE_SECRET_KEY=
UFILE_BUCKET=goat
UFILE_REGION=cn-sh2
UFILE_ENDPOINT=https://s3-cn-sh2.ufileos.com
UFILE_USE_PATH_STYLE=true
# API 层拼接媒体 URL 的基址（换域名只改这里）
MEDIA_BASE_URL=https://goat.cn-sh2.ufileos.com
MEDIA_DISK=ufile

# --- 采集系统内部 API（站点 → collector，HMAC 鉴权，密钥不进仓库）---
COLLECTOR_BASE_URL=http://127.0.0.1:8020
COLLECTOR_HMAC_KEY=
COLLECTOR_HMAC_TTL=300

# --- 安全 / 观测 ---
SESSION_DRIVER=redis
CACHE_STORE=redis
LOG_CHANNEL=stack
LOG_LEVEL=debug
