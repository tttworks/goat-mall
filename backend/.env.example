# GOAT 潮玩交易平台 · 站点系统后端环境样例（占位值，真实凭据只存服务器 .env / gobt_secrets.env）
# Copyright © 火山文化科技（天津市火山文化科技有限责任公司） / Author: Aloysius Luo

APP_NAME="GOAT Mall"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://goat.websitedemos.cn
APP_LOCALE=zh_CN

# --- 应用进程（Octane / Swoole）---
OCTANE_SERVER=swoole
OCTANE_HTTPS=false
OCTANE_WORKERS=4
OCTANE_MAX_REQUESTS=500

# --- PostgreSQL 17（经 PgBouncer 连接，事务池模式）---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=6432
DB_DATABASE=goat_mall
DB_USERNAME=goat
DB_PASSWORD=
DB_SCHEMA=public

# --- Redis（独立 DB index：0 缓存 / 1 队列 / 2 广播）---
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1
REDIS_QUEUE=goat:default
REDIS_PREFIX=goat:

# --- 队列（Horizon）---
QUEUE_CONNECTION=redis
HORIZON_PREFIX=goat_horizon:

# --- 广播（Reverb WebSocket）---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=goat.websitedemos.cn
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# --- Meilisearch ---
# 本地未起 Meili 时改 SCOUT_DRIVER=null：图鑑关键词检索会自动降级为 SQL ILIKE，不影响浏览/后台
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
SCOUT_PREFIX=goat_
# 索引写入走队列（Meili 抖动不会阻塞后台保存）
SCOUT_QUEUE=true

# --- 对象存储 UCloud UFile（S3 协议）；DB 只存对象 key ---
FILESYSTEM_DISK=ufile
UFILE_ACCESS_KEY=
UFILE_SECRET_KEY=
UFILE_BUCKET=goat
UFILE_REGION=cn-sh2
UFILE_ENDPOINT=https://s3-cn-sh2.ufileos.com
UFILE_USE_PATH_STYLE=true
# API 层拼接媒体 URL 的基址（换域名只改这里）
MEDIA_BASE_URL=https://goat.cn-sh2.ufileos.com
# 生产 ufile；本地无 UFile 凭据时改 ufile_local（服务端代传，行为一致）
MEDIA_DISK=ufile
# 直传签名有效期（分钟）
MEDIA_PRESIGN_TTL=15

# --- 采集系统内部 API（站点 → collector，HMAC 鉴权，密钥不进仓库）---
COLLECTOR_BASE_URL=http://127.0.0.1:8020
COLLECTOR_HMAC_KEY=
COLLECTOR_HMAC_TTL=300

# --- 认证（T2）：四通道 + Token 有效期 ---
GOAT_AUTH_TOKEN_TTL=43200
GOAT_AUTH_USERNAME_ENABLED=true
GOAT_AUTH_EMAIL_ENABLED=true
GOAT_AUTH_WECHAT_ENABLED=true
GOAT_AUTH_APPLE_ENABLED=true
# 手机号通道预留：短信通道未采购，保持 false（零采购原则）
GOAT_AUTH_PHONE_ENABLED=false
GOAT_AUTH_PASSWORD_MIN=8
GOAT_AUTH_THROTTLE_LOGIN=10,1
GOAT_AUTH_THROTTLE_REGISTER=5,1
GOAT_AUTH_THROTTLE_PROVIDER=20,1

# 微信小程序登录（code → openid；session_key 不落库）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Apple Sign in（iOS 上架必需；client_id 必须等于 Bundle ID）
APPLE_CLIENT_ID=
APPLE_BUNDLE_ID=

# 实名核身（按次付费，仅开店触发；driver: null=仅本地演示 / http=正式服务商）
GOAT_IDENTITY_DRIVER=null
IDENTITY_BASE_URL=
IDENTITY_KEY=
# 证件号去重 HMAC 盐；上线后不可更换
GOAT_IDENTITY_HASH_SALT=

# --- 交易与竞拍（T4）---
# 下单锁库时长（分钟）：超时释放库存
GOAT_TRADE_RESERVE_MINUTES=30
# 待付款订单自动关闭（分钟）
GOAT_TRADE_PAYMENT_TIMEOUT_MINUTES=30
# 发货后自动确认收货（天）
GOAT_TRADE_AUTO_CONFIRM_DAYS=10
# 费率兜底（bip = 万分比，0 = 免费期）；DB fee_rules 命中时以 DB 为准
GOAT_TRADE_DEFAULT_FEE_BIP=0
GOAT_TRADE_DEFAULT_FEE_CAP=
GOAT_TRADE_DEFAULT_FEE_BEARER=seller
# 防狙击：最后 N 秒出价自动延时
GOAT_AUCTION_ANTI_SNIPE_SECONDS=60
GOAT_AUCTION_EXTENSION_SECONDS=60
GOAT_AUCTION_MAX_EXTENSIONS=10
GOAT_AUCTION_MIN_INCREMENT=1.00

# --- 支付与担保交易（T5）：零采购，无商户号时固定 sandbox ---
GOAT_PAYMENT_CHANNEL=sandbox
# 回调验签密钥：生产必须强随机，且与任何真实渠道密钥不同
GOAT_PAYMENT_SANDBOX_SECRET=
# 异步通知时间戳容忍窗口（秒），防重放
GOAT_PAYMENT_NOTIFY_TOLERANCE=300
# 买家确认收货后自动结算给卖家
GOAT_PAYMENT_AUTO_SETTLE=true

# --- 社群 UGC 与机审（T6）---
# true = 机审通过直接发布；false = 全部转人工（灰度期建议 false）
GOAT_COMMUNITY_AUTO_PUBLISH=true
GOAT_COMMUNITY_POST_MAX_IMAGES=9
GOAT_COMMUNITY_POST_MAX_LENGTH=1000
# 机审驱动：keyword（零采购默认）/ http（云厂商内容安全）
GOAT_MODERATION_DRIVER=keyword
# 违规词表（逗号分隔，不进代码）
GOAT_MODERATION_KEYWORDS=
GOAT_MODERATION_BASE_URL=
GOAT_MODERATION_KEY=
GOAT_MODERATION_TIMEOUT=5

# --- 私信（T6）：本轮 HTTP 拉取，WS 推送留后续 ---
GOAT_IM_MAX_LENGTH=1000
GOAT_IM_WS_ENABLED=false

# --- 安全 / 观测 ---
SESSION_DRIVER=redis
CACHE_STORE=redis
LOG_CHANNEL=stack
LOG_LEVEL=debug
